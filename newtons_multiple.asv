function [x0, exit_flag] = newton_solver_mult(fun,x0,dxtol,ftol,max_iter, j_type)
    iter = 1;
    exit_flag = 0;

    if j_type == 0

        [f_x, j] = fun(x0);
    else
        [f_x, ~] = fun(x0);
        j = j_approx(fun, x0);
    end

    x1 = x0 - j\f_x;

    while sum(abs(f_x)) > ftol && sum(abs(x1-x0)) > dxtol
        
        if det(j*j') > dxmax
            exit_flag = 1;
            break
        end

        x0 = x1;
        [f_x, dfdx] = fun(x0);
        
       if dfdx == 0
            exit_flag = 1;
            break
       end

       x1 = x0 - f_x/dfdx;

       iter = iter + 1;

       if iter >= max_iter
            exit_flag = 2;
            break
       end
    end
end
